APP_ENV=production
APP_SECRET_KEY=replace-with-strong-secret
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
DATABASE_URL=postgresql+psycopg://user:password@host:5432/datahub
REDIS_URL=redis://host:6379/0
CHROMA_URL=http://chroma:8000
LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-key
GROQ_MODEL=llama-3.1-8b-instant
OIDC_ISSUER=https://issuer.example.com
OIDC_CLIENT_ID=replace-client-id
OIDC_CLIENT_SECRET=replace-client-secret
OIDC_REDIRECT_URI=https://app.yourdomain.com/auth/callback
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-service-role-key
SUPABASE_JWT_SECRET=replace-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated
DATASET_CACHE_MAX=100
DATASET_CACHE_TTL=1800
PROFILE_CACHE_TTL=300
PROFILE_CACHE_MAX=500
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=replace-aws-key
AWS_SECRET_ACCESS_KEY=replace-aws-secret
AWS_REGION=us-east-1
S3_BUCKET_NAME=datahub-datasets
R2_ACCOUNT_ID=replace-r2-account
R2_ACCESS_KEY_ID=replace-r2-key
R2_SECRET_ACCESS_KEY=replace-r2-secret
R2_BUCKET_NAME=datahub-datasets
QUERY_CACHE_TTL=3600
ENABLE_QUERY_CACHE=true
ENABLE_AUTO_ARCHIVAL=true
COMPRESSION_LEVEL=9
DATASET_INLINE_MAX_ROWS=5000
PUBLIC_BASE_URL=https://app.yourdomain.com
SHARED_RATE_LIMIT_PER_MIN=240
SHARE_SIGNING_SECRET=replace-with-random-secret
SHARE_SCOPE_ALLOWLIST=public,partners,internal
SHARE_SCOPE_POLICY_PUBLIC=editor
SHARE_SCOPE_POLICY_PARTNERS=editor
SHARE_SCOPE_POLICY_INTERNAL=viewer
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-anon-key
VITE_ENABLE_BILLING=false
METRICS_BEARER_TOKEN=replace-with-random-token
